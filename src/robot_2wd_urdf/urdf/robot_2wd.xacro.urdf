<?xml version="1.0"?>
<robot name="robot_2wd"  xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>

  <material name="red">
    <color rgba="0 0.8 0 1"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
    </visual>
  </link>

  <link name="chassis">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/> 
      <geometry>
        <cylinder length="0.05" radius="0.2"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.2"/>
      </geometry>
    </collision>
  </link>
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0.05"/>
  </joint>
  
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.03"/>

  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
	      <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
      <material name="red"/>
    </visual> 
  </link>
  <joint  name="left_wheel_joint" type="continuous">
    <origin xyz="0 -0.2 0" rpy ="1.5708 0 0"/>
    <axis xyz="0 0 -1"/>
    <parent link="chassis"/>
    <child link="left_wheel"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="0 0.2 0" rpy = "1.5708 0 0"/>
    <axis xyz="0 0 -1"/>
    <parent link="chassis"/>
    <child link="right_wheel"/>
  </joint>
  
  <link name="top_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
	      <sphere radius="0.0125"/>
      </geometry>
      <material name="red"/>
    </visual> 
  </link>
  <joint  name="top_wheel_joint" type="continuous">
    <origin xyz="-0.15 0 -0.0375"/>
    <axis xyz="0 0 1"/>
    <parent link="chassis"/>
    <child link="top_wheel"/>
  </joint>
  
  <link name="back_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
	      <sphere radius="0.0125"/>
      </geometry>
      <material name="red"/>
    </visual> 
  </link>
  <joint  name="back_wheel_joint" type="continuous">
    <origin xyz="0.15 0 -0.0375"/>
    <axis xyz="0 0 1"/>
    <parent link="chassis"/>
    <child link="back_wheel"/>
  </joint>
  
    <ros2_control name="RobotHardware" type="system">
      <hardware>
        <plugin>ros2_control_demo_hardware/DiffDriveSystemHardware</plugin>
      </hardware>

      <joint name="left_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="right_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <transmission name="left_wheel_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="left_wheel_joint">
            <hardwareInterface>velocity</hardwareInterface>
        </joint>
        <actuator name="left_wheel_motor"/>
      </transmission>

      <transmission name="right_wheel_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="right_wheel_joint">
            <hardwareInterface>velocity</hardwareInterface>
        </joint>
        <actuator name="right_wheel_motor"/>
      </transmission>
    </ros2_control>
    
  <gazebo>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin"
            filename="libgz_ros2_control-system.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <robotBaseFrame>base_link</robotBaseFrame>
      <wheelSeparation>0.3</wheelSeparation>
      <wheelRadius>0.05</wheelRadius>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
    </plugin>
  </gazebo>

</robot>

