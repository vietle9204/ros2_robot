<?xml version="1.0"?>
<sdf version="1.9">
  <world name="default">
    <!-- Include default ground and sun -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Include robot model -->
    <include>
      <uri>model://robot_2wd</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>

